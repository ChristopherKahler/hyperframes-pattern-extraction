# ElevenLabs Scribe — only needed if you use --engine scribe.
ELEVENLABS_API_KEY=

# HuggingFace token for pyannote diarization (local engine).
# 1. Create at https://huggingface.co/settings/tokens (Read scope is enough).
# 2. Accept terms at https://huggingface.co/pyannote/speaker-diarization-3.1
#    and https://huggingface.co/pyannote/segmentation-3.0 (required once per
#    account; click "Agree and access repository").
# Leave blank to skip diarization — transcripts still work, just no speaker tags.
HF_TOKEN=
